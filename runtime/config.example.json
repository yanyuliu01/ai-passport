{
  "server": {
    "name": "",
    "host": "127.0.0.1",
    "port": 8765,
    "token": "change-me-to-a-long-random-string"
  },
  "state_dir": "state",
  "persona_file": "persona.txt",
  "brief_max_chars": 120,
  "turn_timeout_seconds": 3600,
  "xiaoyou": {
    "default_agent": "claude",
    "voice_agent": null,
    "max_parallel": 0,
    "voice_timeout_seconds": 60,
    "router": {
      "type": "mention"
    }
  },
  "agents": {
    "claude": {
      "type": "claude_code",
      "description": "Claude Code：日常问答、读文件和搜索、查网页。",
      "command": ["claude"],
      "workdir": "workdir",
      "config_dir": null,
      "model": null,
      "permission_mode": "manual",
      "allowed_tools": ["Read", "Glob", "Grep", "WebSearch", "WebFetch"],
      "add_dirs": ["~"],
      "extra_args": []
    },
    "deepseek": {
      "type": "claude_code",
      "enabled": false,
      "description": "Claude Code 的外壳，模型换成 DeepSeek V4。",
      "command": ["claude"],
      "workdir": "workdir",
      "config_dir": "~/.claude-xiaoyou-deepseek",
      "model": "deepseek-v4-pro",
      "permission_mode": "dontAsk",
      "allowed_tools": ["Read", "Glob", "Grep", "WebSearch", "WebFetch"],
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
        "ANTHROPIC_AUTH_TOKEN": ""
      }
    },
    "codex": {
      "type": "codex",
      "enabled": false,
      "description": "OpenAI Codex 命令行：看代码、改代码、给第二意见。",
      "aliases": [],
      "command": ["codex"],
      "workdir": "workdir",
      "config_dir": null,
      "mode": "app_server",
      "approval_policy": "on-request",
      "sandbox": "read-only",
      "model": null
    }
  },
  "stt": {
    "engine": "none",
    "model_dir": "stt-models/sense-voice",
    "language": "auto",
    "threads": 2
  }
}
