{
  "name": "xiaoyu-desktop",
  "version": "0.1.27",
  "private": true,
  "description": "Xiaoyu desktop companion",
  "author": "AI Passport contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist-main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:ui": "tsc --noEmit -p tsconfig.json && vite build",
    "build": "npm run build:main && npm run build:ui",
    "test": "npm run build:main && node --test dist-main/test/*.test.js",
    "start": "npm run build && electron .",
    "bundle:runtime": "python3 tools/bundle_runtime.py",
    "package:mac": "npm run build && electron-builder --mac dir dmg --arm64",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:win-preview": "npm run build && electron-builder --config tools/windows-preview-builder.cjs --win nsis --x64",
    "relay": "node dist-main/relay/server.js",
    "bundle:agents": "python3 tools/bundle_agents.py"
  },
  "build": {
    "appId": "com.folotoy.xiaoyu",
    "productName": "\u5c0f\u9c7c",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-main/**/*",
      "!dist-main/test/**/*",
      "dist-ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime-dist",
        "to": "runtime"
      },
      {
        "from": "agents-dist",
        "to": "agent-tools"
      }
    ],
    "beforePack": "./tools/check-package.cjs",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "dir"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterPack": "./tools/check-packed-agents.cjs"
  },
  "dependencies": {
    "hpke-js": "1.8.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "selfsigned": "5.5.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
